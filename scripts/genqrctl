#!/usr/bin/env bash
# genqrctl — control the GenQR service on Linux.
#
# install.sh copies this file to /usr/local/bin/genqrctl (owned by root). It deliberately
# sources nothing from the GenQR folder: that folder belongs to the service account, and
# root must never run code the service account can change. Application commands run as
# the service account; only service start/stop/restart and log reading use root.
set -euo pipefail

# Written by install.sh (root-owned): GENQR_DIR and GENQR_USER.
[ -r /etc/genqr.conf ] && . /etc/genqr.conf
GENQR_DIR="${GENQR_DIR:-/opt/genqr}"
GENQR_USER="${GENQR_USER:-genqr}"
SERVICE="genqr"
ORIG_ARGS=("$@")

die() { printf '\033[1;31mError:\033[0m %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[1;33mWarning:\033[0m %s\n' "$*" >&2; }

usage() {
  cat <<EOF
Usage: genqrctl <command> [options]

Service
  status                       Service state, version, database and health
  start | stop | restart       Control the service
  logs [-f] [journalctl opts]  Show (or follow) the service log

Maintenance
  update [--force]             Pull the latest version from GitHub and restart
  reset-password <username>    Set a new password for a local user
        [--unlock] [--must-change] [--password-stdin]
  setup-token                  Show the first-launch setup token
  backup <file>                Back up the database (SQLite: .db copy; any engine: .json.gz dump)
  restore <file>               Replace all data with a backup (stops and restarts the service)
  migrate                      Apply database migrations

Database
  db-status                    Engine in use, driver, row counts
  db-switch --client <mysql|pg|sqlite> --host H --port P --database D --user U [--ssl]
                               Copy everything to another empty database and switch to it
                               (stops the service, copies, starts it again)
  install-driver               Install the driver for the configured database
  version                      Show version and commit

Installed in: $GENQR_DIR (service account: $GENQR_USER)
EOF
}

need_root() { [ "$(id -u)" -eq 0 ] || exec sudo "$0" "${ORIG_ARGS[@]}"; }

# Runs a command as the service account, from the install folder.
as_app() {
  if [ "$(id -un)" = "$GENQR_USER" ]; then
    (cd "$GENQR_DIR" && GENQR_ROOT="$GENQR_DIR" NODE_ENV=production "$@")
  elif [ "$(id -u)" -eq 0 ]; then
    (cd "$GENQR_DIR" && runuser -u "$GENQR_USER" -- env HOME="$GENQR_DIR" GENQR_ROOT="$GENQR_DIR" NODE_ENV=production "$@")
  else
    exec sudo "$0" "${ORIG_ARGS[@]}"
  fi
}

run_cli() { as_app node server/dist/cli/index.js "$@"; }

read_port() {
  local port
  port="$(sed -n 's/^PORT=//p' "$GENQR_DIR/.env" 2> /dev/null | tail -n1 | tr -dc '0-9')"
  echo "${port:-3000}"
}

wait_healthy() {
  local port i
  port="$(read_port)"
  for i in $(seq 1 60); do
    curl -fsS --max-time 3 "http://127.0.0.1:${port}/api/health" > /dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

status() {
  local state since port health
  state="$(systemctl show -p ActiveState --value "$SERVICE")/$(systemctl show -p SubState --value "$SERVICE")"
  since="$(systemctl show -p ActiveEnterTimestamp --value "$SERVICE")"
  port="$(read_port)"
  if curl -fsS --max-time 3 "http://127.0.0.1:${port}/api/health" > /dev/null 2>&1; then health="OK"; else health="NOT RESPONDING"; fi
  echo "Service:  $SERVICE $state${since:+ since $since}"
  echo "Health:   $health (http://127.0.0.1:${port}/api/health)"
  run_cli version | sed '1s/^/Version:  /; 2,$s/^/          /'
  [ "$health" = "OK" ]
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  status) need_root; status ;;
  start | stop | restart)
    need_root
    systemctl "$cmd" "$SERVICE"
    if [ "$cmd" != "stop" ]; then
      wait_healthy || die "Service did not become healthy; see: genqrctl logs"
    fi
    status || true
    ;;
  logs) journalctl -u "$SERVICE" -n 200 --no-pager "$@" ;;
  # The updater runs entirely as the service account; it restarts the service through a
  # sudoers rule limited to start/stop/restart of genqr.service.
  update) as_app "$GENQR_DIR/scripts/update.sh" "$@" ;;
  reset-password | setup-token | backup | migrate | version | db-status | install-driver) run_cli "$cmd" "$@" ;;
  restore | db-switch)
    need_root
    systemctl stop "$SERVICE"
    status_code=0
    run_cli "$cmd" "$@" || status_code=$?
    systemctl start "$SERVICE"
    wait_healthy || warn "GenQR did not report healthy yet; see: genqrctl logs"
    exit "$status_code"
    ;;
  help | -h | --help) usage ;;
  *) usage; exit 1 ;;
esac
