# Copied to .env by scripts/install.sh (which generates ENCRYPTION_KEY). Never commit .env.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Express "trust proxy": "loopback" when the reverse proxy runs on this host.
TRUST_PROXY=loopback
# 32 random bytes, base64. Encrypts stored secrets (AD bind password, SMTP password, DB password).
# Changing it makes those stored secrets unreadable.
ENCRYPTION_KEY=
