# Installed by scripts/install.sh — @GENQR_DIR@ and @NODE_BIN@ are substituted at install time.
[Unit]
Description=GenQR - QR code generator and short-link service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@GENQR_USER@
Group=@GENQR_USER@
WorkingDirectory=@GENQR_DIR@
Environment=NODE_ENV=production
Environment=GENQR_ROOT=@GENQR_DIR@
ExecStart=@NODE_BIN@ @GENQR_DIR@/server/dist/index.js
# Always: the app exits on purpose to restart itself (e.g. after a database switch)
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# Files the app creates (database, uploads, logs) are not readable by other local users.
UMask=0027

[Install]
WantedBy=multi-user.target
